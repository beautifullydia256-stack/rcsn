{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/)(?!assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/admin/create-user-account.js": {
      "includeFiles": "lib/**"
    },
    "api/admin/ensure-parent-link.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/lesson-plan.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/ai/exam.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/ai/generate-pdf.ts": {
      "includeFiles": "src/lib/**"
    }
  },
  "env": {
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "true"
  }
}
