{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/)(?!assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/admin/create-user-account.js": {
      "includeFiles": "lib/**"
    },
    "api/admin/ensure-parent-link.js": {
      "includeFiles": "lib/**"
    },
    "api/pdf/generate.ts": {
      "includeFiles": "lib/pdfOlevelStandardPage.ts"
    },
    "api/webhooks/wasender.mjs": {}
  },
  "env": {
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true"
  }
}
