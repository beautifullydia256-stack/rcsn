{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/admin/create-user-account.js": {
      "includeFiles": "lib/**"
    },
    "api/admin/ensure-parent-link.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/lesson-plan.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/exam.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/generate-pdf.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/status.js": {
      "includeFiles": "lib/**"
    },
    "api/webhooks/wasender.mjs": {
      "maxDuration": 60
    },
    "api/integrations/schoolpay/settings.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/integrations/schoolpay/sync.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/webhooks/schoolpay/[token].ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/owner/system-health.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "true"
  },
  "ignoreCommand": "npx vercel-ignore"
}
