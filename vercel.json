{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/)(?!assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/admin/create-user-account.js": {
      "includeFiles": "lib/**"
    },
    "api/admin/ensure-parent-link.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/lesson-plan.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/exam.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/generate-pdf.js": {
      "includeFiles": "lib/**"
    },
    "api/ai/status.js": {
      "includeFiles": "lib/**"
    },
    "api/webhooks/wasender.mjs": {
      "maxDuration": 60
    },
    "api/integrations/schoolpay/settings.ts": {
      "includeFiles": "src/lib/**"
    },
    "api/integrations/schoolpay/sync.ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/webhooks/schoolpay/[token].ts": {
      "maxDuration": 60,
      "includeFiles": "src/lib/**"
    },
    "api/pdf/generate.js": {
      "maxDuration": 60,
      "memory": 3008
    },
    "api/owner/system-health.ts": {
      "maxDuration": 30
    },
    "api/teacher/punch.js": {
      "maxDuration": 15
    },
    "api/admin/delete-teacher.js": {
      "maxDuration": 15
    },
    "api/admin/broadcast.js": {
      "maxDuration": 30
    },
    "api/notifications/send.js": {
      "maxDuration": 60
    },
    "api/webhooks/biometric-attendance.js": {
      "maxDuration": 15
    },
    "api/admin/notify-role-change.js": {
      "includeFiles": "lib/**"
    },
    "api/referrals/verify.js": {
      "includeFiles": "src/lib/**"
    },
    "api/register/school.js": {
      "includeFiles": "lib/**"
    },
    "api/test-db-function.js": {
      "includeFiles": "lib/**"
    }
  },
  "env": {
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "true"
  },
  "ignoreCommand": "npx vercel-ignore"
}
