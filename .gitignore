# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist
/release

# misc
.DS_Store
*.pem
.gradle/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# generated build artifacts (not source)
# api/pdf/generate.js is intentionally tracked — it is the esbuild entry point
# for Vercel's pre-build function validation. The real bundle is written over it
# by build:pdf-api during the Vercel build. Do not commit the full bundle.

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.production

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Diagnostic SQL files (temporary debugging files)
*_debug*.sql
*_check*.sql
*_fix*.sql
quick_*.sql
debug_*.sql

# Desktop app: real Supabase config (never commit). Copy supabase_config.json.example to supabase_config.json.
desktop-app/app/src/main/resources/supabase_config.json

# Desktop (Gradle / Android) — build outputs and local state (never commit)
desktop-app/.gradle/
desktop-app/**/build/
desktop-app/**/.cxx/
desktop-app/local.properties
desktop-app/**/.idea/
desktop-app/**/*.iml
# Do not upload desktop app tree to Vercel (see .vercelignore); sources stay in git for developers.

# Cursor / local scratch
.cursor/plans/
_tmp_*
**/_tmp_*.ts
**/_tmp_*.txt
schema_dump.sql
supabase/_tmp_*.sql
supabase/.temp/
scratch/