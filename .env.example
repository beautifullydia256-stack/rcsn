# Copy to .env.local and fill in values. Never commit real secrets.

# --- Public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When the Vite app runs on port 3000, run Next for API routes on 3001: `npm run dev:next`
# and set this for browser calls to /api/referrals/* and /api/register/* from the SPA:
# NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Server-only ---
SUPABASE_SERVICE_ROLE_KEY=

# Referral-gated registration: sign JWTs from POST /api/referrals/verify (min 16 characters).
# Generate example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFERRAL_JWT_SECRET=

# Optional: Cloudflare Turnstile server verify for POST /api/register/school (when NEXT_PUBLIC_TURNSTILE_SITE_KEY is set).
# TURNSTILE_SECRET_KEY=

# SchoolPay (Uganda): encrypts per-school API passwords in Postgres; min 16 characters.
# Generate example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCHOOLPAY_CREDENTIALS_SECRET=

# Optional: canonical production URL for SchoolPay webhook shown in admin (else NEXT_PUBLIC_APP_URL / VERCEL_URL).
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: Bearer token for GET /api/cron/schoolpay-sync (or set CRON_SECRET).
# SCHOOLPAY_SYNC_CRON_SECRET=
