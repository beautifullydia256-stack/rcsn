# PwezaCore Supabase (same database as main app / desktop / android)
# Copy this file to .env and fill in values from your PwezaCore Supabase project.
# You can use the same VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY as in the main pwezacore .env.local
# or from desktop-app supabase_config.json (use supabaseUrl and supabaseAnonKey).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: for server-side or admin operations only (never expose in public builds)
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
