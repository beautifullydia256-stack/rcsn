{
  "name": "pwezacore",
  "version": "0.2.5",
  "description": "PwezaCore — Complete school management platform for student enrollment, fee collection and payment tracking, attendance management, exam results and report cards, staff and teacher management, parent communication, expense tracking, visitor logs, and full school administration. Designed for African schools. Works fully offline.",
  "author": "PwezaCore",
  "private": true,
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/DRKIMULI/school-management-system.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:next": "next dev -p 3001",
    "dev:desktop": "cross-env VITE_DESKTOP_MODE=true vite",
    "build": "tsc && vite build && node scripts/bundle-wasender-webhook.cjs",
    "build:desktop": "cross-env VITE_DESKTOP_MODE=true tsc && cross-env VITE_DESKTOP_MODE=true vite build && node scripts/bundle-wasender-webhook.cjs",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "desktop": "concurrently -k \"cross-env VITE_DESKTOP_MODE=true vite\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_DEV=1 electron .\"",
    "bump:patch": "npm version patch --no-git-tag-version",
    "pack:win": "npm run build:desktop && node scripts/build-windows-icon.cjs && electron-builder --win nsis --x64 && node scripts/clean-nsis-intermediates.cjs",
    "pack:win:signed": "npm run build:desktop && node scripts/build-windows-icon.cjs && electron-builder --win nsis --x64 && node scripts/clean-nsis-intermediates.cjs",
    "pack:win:msi": "npm run build:desktop && node scripts/build-windows-icon.cjs && electron-builder --win msi --x64",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:resend": "node scripts/test-resend.mjs",
    "check:secondary-exam-rpc": "node scripts/check-secondary-exam-rpc-signatures.mjs",
    "db:compress-student-photos": "node scripts/compress-student-photos-in-db.mjs",
    "supabase": "supabase"
  },
  "build": {
    "appId": "com.pwezacore.school",
    "productName": "PwezaCore",
    "icon": "public/logo.png",
    "afterPack": "scripts/afterPackWinIcon.cjs",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/pack-assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "installerIcon": "electron/pack-assets/icon.ico",
      "uninstallerIcon": "electron/pack-assets/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DRKIMULI",
        "repo": "school-management-system"
      }
    ]
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-react-beautiful-dnd-autoscroll": "^2.0.2",
    "@marsidev/react-turnstile": "^1.3.1",
    "@sparticuz/chromium": "^138.0.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.89.0",
    "@types/nodemailer": "7.0.2",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "docx": "^9.5.1",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.0.0",
    "grapesjs": "^0.22.13",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-component-countdown": "^1.0.2",
    "grapesjs-custom-code": "^1.0.2",
    "grapesjs-parser-postcss": "^1.0.3",
    "grapesjs-plugin-export": "^1.0.12",
    "grapesjs-plugin-forms": "^2.0.6",
    "grapesjs-preset-webpage": "^1.0.3",
    "grapesjs-style-bg": "^2.0.2",
    "grapesjs-tabs": "^1.0.6",
    "grapesjs-touch": "^0.1.1",
    "html2canvas": "^1.4.1",
    "jose": "^5.10.0",
    "jsbarcode": "^3.11.6",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "0.546.0",
    "next": "^15.5.15",
    "nodemailer": "^7.0.6",
    "openai": "^6.9.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "puppeteer": "^24.22.3",
    "puppeteer-core": "^24.22.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-is": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "recharts": "3.3.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.18.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.29",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fast-check": "^4.7.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.47",
    "rcedit": "^4.0.1",
    "supabase": "^2.90.0",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  }
}
